rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isMember() {
      return signedIn() && exists(userDoc()) && get(userDoc()).data.aktif == true;
    }
    function isAdmin() { return isMember() && get(userDoc()).data.role == 'admin'; }
    function setupDone() { return exists(/databases/$(database)/documents/meta/setup); }

    // Penanda bahwa admin pertama sudah dibuat. Boleh dibaca publik
    // agar halaman login tahu apakah perlu menampilkan "Setup awal".
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn() && !setupDone()
        && getAfter(userDoc()).data.role == 'admin';
      allow update, delete: if false;
    }

    // Pengguna aplikasi. Hanya admin yang boleh menambah/mengubah,
    // kecuali saat setup awal (admin pertama mendaftarkan dirinya sendiri).
    match /users/{uid} {
      allow read: if isMember();
      allow create: if isAdmin()
        || (signedIn() && !setupDone() && request.auth.uid == uid
            && request.resource.data.role == 'admin' && request.resource.data.aktif == true);
      // admin boleh mengubah semua; pengguna lain hanya boleh mengganti namanya sendiri
      allow update: if isAdmin()
        || (isMember() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama']));
      allow delete: if false;
    }

    // Pengaturan lembaga: semua pengguna boleh baca, hanya admin yang ubah.
    match /settings/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Log aktivitas: ditulis oleh pengguna aktif atas namanya sendiri, hanya admin yang membaca,
    // tidak bisa diubah atau dihapus siapa pun.
    match /log/{id} {
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Portal wali: satu dokumen per tautan rahasia. Siapa pun yang memegang tautan boleh
    // membaca dokumennya (get), tetapi tidak boleh menelusuri daftar portal (list).
    match /portal/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isMember();
    }

    // Data master, transaksi & akademik: pengguna aktif boleh baca/tambah/ubah,
    // penghapusan (termasuk pembatalan transaksi) hanya admin.
    match /{coll}/{id} {
      allow read, create, update: if isMember() && coll in
        ['kelas','santri','ustadz','kewajiban','komponen','akun',
         'tagihan','pembayaran','gaji','kas','counters',
         'hafalan','hafalanRingkas','absensi','rapor'];
      allow delete: if isAdmin() && coll in
        ['kelas','santri','ustadz','kewajiban','komponen','akun',
         'tagihan','pembayaran','gaji','kas',
         'hafalan','hafalanRingkas','absensi','rapor'];
    }
  }
}
